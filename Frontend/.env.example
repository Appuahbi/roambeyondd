# Backend API base (Vercel build + runtime), e.g. https://api.onrender.com/api.
# Falls back to a same-origin /api proxy for local dev.
VITE_API_BASE_URL=/api

# Backend origin for the realtime socket (no /api suffix), e.g. https://api.onrender.com.
# Falls back to same-origin sockets in local dev.
VITE_SOCKET_URL=/

# Public site origin, e.g. https://roambeyonddeploy.vercel.app
VITE_SITE_URL=http://localhost:3000

# Used by scripts/generate-sitemap.mjs (prebuild). Same values as above.
API_URL=http://localhost:5000/api
SITE_URL=http://localhost:3000