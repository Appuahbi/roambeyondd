PORT=

MONGO_URI=

JWT_SECRET=generate_me_with_crypto.randomBytes(48).toString('hex')

JWT_EXPIRE=

NODE_ENV=

REDIS_URL=

CORS_ORIGIN=

BCRYPT_SALT_ROUNDS=

SMTP_HOST=

SMTP_PORT=

SMTP_USER=

# For Gmail SMTP this must be an App Password (Google Account → Security → 2-Step Verification → App passwords)
SMTP_PASS=

SMTP_FROM=

# Address that receives new lead alerts (enquiries / trip requests).
# Falls back to all admin user emails when unset.
LEAD_ALERT_EMAIL=

FRONTEND_URL=

# Public API base, e.g. https://api.roambeyond.travel/api. Used for admin
# lead-alert email links (falls back to http://localhost:5000 when unset).
API_URL=

# Twilio SMS OTP (authentication). Leave credentials blank to enable mock mode,
# where OTPs are logged instead of sent (safe for local development).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OTP settings
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Allow users without an account to submit package enquiries (true/false)
ALLOW_GUEST_ENQUIRIES=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI chat assistant (Travis AI). Provider: openai | gemini | ollama
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_MODEL=
AI_MAX_TOKENS=